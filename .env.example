# Variables de entorno del Taller de Don Rover (proyecto de Vercel).
# En Vercel se configuran en Settings → Environment Variables. Nunca subas valores reales.

# --- Base de datos (Supabase) ---------------------------------------------------------
# La integración de Supabase en Vercel las crea sola. La función /api/colonies usa la
# primera que encuentre de estas (la del pooler es la recomendada para funciones):
POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# DATABASE_URL=

# --- IA: Claude Opus 5.5 en el servidor -------------------------------------------------
# Crea una clave en https://platform.claude.com y agrégala aquí. Sin clave, el juego usa
# visión local y plantillas (o la clave que el profesor escriba en Ajustes).
ANTHROPIC_API_KEY=
# Opcional: otro modelo (por defecto claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
